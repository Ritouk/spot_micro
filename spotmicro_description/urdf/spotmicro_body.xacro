<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- Dimensions from kinematics.py (mm → m) -->
    <xacro:property name="body_length" value="0.140" />
    <xacro:property name="body_width"  value="0.075" />
    <xacro:property name="body_height" value="0.040" />

    <xacro:property name="l1" value="0.050" />  <!-- hip external (shoulder width) -->
    <xacro:property name="l2" value="0.020" />  <!-- hip internal offset -->
    <xacro:property name="l3" value="0.120" />  <!-- upper leg -->
    <xacro:property name="l4" value="0.155" />  <!-- lower leg -->

    <xacro:property name="leg_radius" value="0.010" />
    <xacro:property name="foot_radius" value="0.015" />

    <!-- ==================== base_footprint ==================== -->
    <link name="base_footprint" />

    <joint name="base_joint" type="fixed">
        <parent link="base_footprint" />
        <child link="base_link" />
        <origin xyz="0 0 ${l3 + l4}" rpy="0 0 0" />
    </joint>

    <!-- ==================== base_link (body) ==================== -->
    <link name="base_link">
        <visual>
            <geometry>
                <box size="${body_length} ${body_width} ${body_height}" />
            </geometry>
            <material name="orange" />
        </visual>
        <collision>
            <geometry>
                <box size="${body_length} ${body_width} ${body_height}" />
            </geometry>
        </collision>
        <inertial>
            <mass value="1.0" />
            <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001" />
        </inertial>
    </link>

    <!-- ==================== Leg macro ==================== -->
    <xacro:macro name="leg" params="prefix x_sign y_sign">
        <!--
            x_sign: +1 for front, -1 for rear
            y_sign: +1 for left, -1 for right
        -->

        <!-- Hip external joint (shoulder) — rotates around X axis -->
        <joint name="${prefix}_hip_external_joint" type="revolute">
            <parent link="base_link" />
            <child link="${prefix}_hip_external_link" />
            <origin xyz="${x_sign * body_length/2} ${y_sign * body_width/2} 0" rpy="0 0 0" />
            <axis xyz="1 0 0" />
            <limit lower="${-pi/2}" upper="${pi/2}" effort="10" velocity="3.0" />
        </joint>

        <link name="${prefix}_hip_external_link">
            <visual>
                <origin xyz="0 ${y_sign * l1/2} 0" rpy="${pi/2} 0 0" />
                <geometry>
                    <cylinder radius="${leg_radius}" length="${l1}" />
                </geometry>
                <material name="dark_grey" />
            </visual>
            <collision>
                <origin xyz="0 ${y_sign * l1/2} 0" rpy="${pi/2} 0 0" />
                <geometry>
                    <cylinder radius="${leg_radius}" length="${l1}" />
                </geometry>
            </collision>
            <inertial>
                <mass value="0.05" />
                <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001" />
            </inertial>
        </link>

        <!-- Hip internal joint — rotates around Y axis -->
        <joint name="${prefix}_hip_internal_joint" type="revolute">
            <parent link="${prefix}_hip_external_link" />
            <child link="${prefix}_hip_internal_link" />
            <origin xyz="0 ${y_sign * l1} 0" rpy="0 0 0" />
            <axis xyz="0 1 0" />
            <limit lower="${-pi/2}" upper="${pi/2}" effort="10" velocity="3.0" />
        </joint>

        <link name="${prefix}_hip_internal_link">
            <visual>
                <origin xyz="0 0 ${-l2/2}" rpy="0 0 0" />
                <geometry>
                    <cylinder radius="${leg_radius}" length="${l2}" />
                </geometry>
                <material name="dark_grey" />
            </visual>
            <collision>
                <origin xyz="0 0 ${-l2/2}" rpy="0 0 0" />
                <geometry>
                    <cylinder radius="${leg_radius}" length="${l2}" />
                </geometry>
            </collision>
            <inertial>
                <mass value="0.05" />
                <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001" />
            </inertial>
        </link>

        <!-- Knee joint — rotates around Y axis -->
        <joint name="${prefix}_knee_joint" type="revolute">
            <parent link="${prefix}_hip_internal_link" />
            <child link="${prefix}_upper_leg_link" />
            <origin xyz="0 0 ${-l2}" rpy="0 0 0" />
            <axis xyz="0 1 0" />
            <limit lower="${-pi/2}" upper="${pi/2}" effort="10" velocity="3.0" />
        </joint>

        <link name="${prefix}_upper_leg_link">
            <visual>
                <origin xyz="0 0 ${-l3/2}" rpy="0 0 0" />
                <geometry>
                    <cylinder radius="${leg_radius}" length="${l3}" />
                </geometry>
                <material name="orange" />
            </visual>
            <collision>
                <origin xyz="0 0 ${-l3/2}" rpy="0 0 0" />
                <geometry>
                    <cylinder radius="${leg_radius}" length="${l3}" />
                </geometry>
            </collision>
            <inertial>
                <mass value="0.1" />
                <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001" />
            </inertial>
        </link>

        <!-- Foot joint (fixed) -->
        <joint name="${prefix}_foot_joint" type="fixed">
            <parent link="${prefix}_upper_leg_link" />
            <child link="${prefix}_lower_leg_link" />
            <origin xyz="0 0 ${-l3}" rpy="0 0 0" />
        </joint>

        <link name="${prefix}_lower_leg_link">
            <visual>
                <origin xyz="0 0 ${-l4/2}" rpy="0 0 0" />
                <geometry>
                    <cylinder radius="${leg_radius * 0.8}" length="${l4}" />
                </geometry>
                <material name="dark_grey" />
            </visual>
            <collision>
                <origin xyz="0 0 ${-l4/2}" rpy="0 0 0" />
                <geometry>
                    <cylinder radius="${leg_radius * 0.8}" length="${l4}" />
                </geometry>
            </collision>
            <inertial>
                <mass value="0.08" />
                <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001" />
            </inertial>
        </link>

        <!-- Foot contact sphere -->
        <joint name="${prefix}_foot_contact_joint" type="fixed">
            <parent link="${prefix}_lower_leg_link" />
            <child link="${prefix}_foot_link" />
            <origin xyz="0 0 ${-l4}" rpy="0 0 0" />
        </joint>

        <link name="${prefix}_foot_link">
            <visual>
                <geometry>
                    <sphere radius="${foot_radius}" />
                </geometry>
                <material name="grey" />
            </visual>
            <collision>
                <geometry>
                    <sphere radius="${foot_radius}" />
                </geometry>
            </collision>
            <inertial>
                <mass value="0.01" />
                <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001" />
            </inertial>
        </link>
    </xacro:macro>

    <!-- ==================== Instantiate 4 legs ==================== -->
    <!-- Right Front: x_sign=+1 (front), y_sign=-1 (right) -->
    <xacro:leg prefix="rf" x_sign="1"  y_sign="-1" />
    <!-- Left Front:  x_sign=+1 (front), y_sign=+1 (left) -->
    <xacro:leg prefix="lf" x_sign="1"  y_sign="1" />
    <!-- Right Back:  x_sign=-1 (rear),  y_sign=-1 (right) -->
    <xacro:leg prefix="rb" x_sign="-1" y_sign="-1" />
    <!-- Left Back:   x_sign=-1 (rear),  y_sign=+1 (left) -->
    <xacro:leg prefix="lb" x_sign="-1" y_sign="1" />

</robot>
